  @import url('https://fonts.googleapis.com/css?family=Nunito+Sans:200,200i,300,300i,400,400i,600,600i,700,700i,800,800i,900,900i&display=swap');
  @media all {
    body {
      font: inherit;
      font-size: 100%;
      background-color: var(--t4s-body-background);
      color: #878787;
      font-family: Arial, Helvetica, sans-serif;
      line-height: 1.6;
    }
  }
  body {
    font-size: 62.5%;
    letter-spacing: 0px;
    color: var(--text-color);
    font-family: var(--font-body-family);
    line-height: 1.7;
    font-weight: 400;
  }
  body {
    /* CSS Variables that may have been missed get put on body */
    --ts-gutter-x: 3rem;
    --ts-gutter-y: 0px;
    --ts-gutter-x: 4px;
    --ts-gutter-y: 4px;
    --ts-gutter-x: 4px;
    --ts-gutter-y: 4px;
    --ts-gutter-x: 4px;
    --ts-gutter-y: 4px;
    --title-cl: var(--pri-cl);
    --btn-cl: var(--second-cl);
    --border-cl: var(--second-cl);
    --title-hover-cl: var(--pri-hover-cl);
