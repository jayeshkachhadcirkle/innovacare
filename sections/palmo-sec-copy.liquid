  }

  @media all {
    .t4s-pr {
      position: relative;
    }

    .t4s-collection-item .t4s-collection-content {
      overflow: hidden;
    }

    .t4s-collection-item .t4s-collection-content {
      background-color: var(--item-cl);
      padding-top: var(--pd-top);
      padding-inline-end: var(--pd-right);
      padding-bottom: var(--pd-bottom);
      padding-inline-start: var(--pd-left);
