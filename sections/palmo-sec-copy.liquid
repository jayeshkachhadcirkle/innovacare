      margin-top: var(--ts-gutter-y);
      box-sizing: border-box;
      flex-shrink: 0;
      width: 100%;
      max-width: 100%;
    }

    .t4s-text-center {
      text-align: center !important;
    }

    .t4s-collection-item {
