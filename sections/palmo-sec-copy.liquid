      border-radius: var(--item-rd);
    }

    .t4s-collection-item .t4s-coll-img {
      position: relative;
    }

    .t4s-eff:before {
      content: '';
      z-index: 1;
      pointer-events: none;
    }

    .t4s-eff:after {
      content: 'ABC';
      z-index: 1;
      pointer-events: none;
    }

    .palmo-sec a {
      margin: 0;
      padding: 0;
      border: 0;
      vertical-align: baseline;
      font: inherit;
      font-size: 100%;
    }

    .palmo-sec a {
      -ms-touch-action: manipulation;
      touch-action: manipulation;
    }

    .palmo-sec a {
      color: #333;
      text-decoration: none;
      transition: all 0.25s ease;
    }
  }

  .palmo-sec a {
    color: var(--link-color);
  }

  @media all {
    .palmo-sec a {
      font-family: Nunito Sans !important;
    }

    .t4s-d-block {
      display: block !important;
    }
  }

  .t4s-d-block {
    display: block;
  }

  @media all {
    .palmo-sec a:hover,
    .palmo-sec a:active {
