{% schema %}
{
  "name": "Palmo Section 2",
  "settings": [
    {
      "type": "range",
      "id": "columns_desktop",
      "label": "Columns (desktop)",
      "default": 6,
      "min": 1,
      "max": 6,
      "step": 1
    },
    {
      "type": "range",
      "id": "columns_mobile",
      "label": "Columns (mobile)",
      "default": 2,
      "min": 1,
      "max": 6,
      "step": 1
    }
  ],
  "blocks": [
    {
      "type": "item",
      "name": "Collection item",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Image" },
        { "type": "collection", "id": "collection", "label": "Collection (optional)" },
        { "type": "url", "id": "link", "label": "Custom link (optional)" },
        { "type": "text", "id": "alt", "label": "Label text" },
        { "type": "checkbox", "id": "open_in_new", "label": "Open link in new window", "default": false },
        {
          "type": "range",
          "id": "aspect_ratio",
          "label": "Aspect ratio (e.g. 0.8)",
          "min": 0.3,
          "max": 3,
          "step": 0.1,
          "default": 0.8
        }
      ]
    }
  ],
  "max_blocks": 12,
  "presets": [
    {
      "name": "Palmo - Collections Section",
      "category": "Palmo Sections 2",
      "blocks": [{ "type": "item", "settings": { "image": "", "collection": "", "link": "", "alt": "" } }]
    }
  ]
}
{% endschema %}
