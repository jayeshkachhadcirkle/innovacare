    }
  }

  @media (-moz-touch-enabled: 0), (hover: hover) and (min-width: 1025px) {
    .palmo-sec a:hover {
      color: var(--link-color-hover);
    }
  }

  @media all {
    .t4s_ratio {
      position: relative;
      width: 100%;
    }

    /* .t4s_ratio p {
      position: absolute;
      bottom: 10px;
      left: 10px;
    } */

    .t4s-child-lazyloaded.t4s-bg-11 {
      background-image: none !important;
    }

    .t4s-collection-item .t4s_ratio {
      border-radius: var(--item-rd);
    }

    .t4s_ratioadapt .t4s_ratio {
      max-width: var(--max-width);
    }

    .t4s_ratioadapt .t4s-text-center .t4s_ratio {
      margin: 0 auto;
      border: 0.5px solid #80808091;
      overflow: hidden;
    }

    .t4s_ratio:before {
      display: block;
      padding-top: var(--t4s-aspect-ratio);
      content: '';
    }

    .t4s_ratioadapt .t4s_ratio::before,
    .t4s_ratioadapt_f .t4s_ratio::before {
      --t4s-aspect-ratio: calc(100% / (var(--aspect-ratioapt)));
    }

    .palmo-sec a:hover {
      outline: none;
      text-decoration: none;
    }

    .palmo-sec img {
      margin: 0;
      padding: 0;
      border: 0;
      vertical-align: baseline;
      font: inherit;
      font-size: 100%;
    }

    .palmo-sec img {
      max-width: 100%;
      height: auto;
      border: 0;
      vertical-align: middle;
    }
  }

  .palmo-sec img {
    height: auto;
    max-width: 100%;
  }

  @media all {
    .palmo-sec a img {
      border: none;
    }

    .t4s-lz--fadeIn {
      opacity: 0;
      transition: opacity 0.35s cubic-bezier(0.215, 0.61, 0.355, 1);
    }

    .t4s_ratio img {
      object-fit: cover;
      object-position: center center;
    }

    .lazyloadt4sed.t4s-lz--fadeIn {
